# Auto-detect text files and normalize line endings
* text=auto

# Force Unix LF for source code
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.rules text eol=lf
*.js text eol=lf

# Force LF for shell scripts
gradlew text eol=lf

# Windows batch files must stay CRLF
gradlew.bat text eol=crlf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.keystore binary
*.jks binary
